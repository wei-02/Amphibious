<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="amphibious">
 
    <xacro:include filename="$(find amphibious_description)/urdf/amphibious.urdf"/>

    <!-- Optional RealSense D435i: include only when enabled -->
    <xacro:arg name="use_d435i" default="false"/>
    <xacro:arg name="use_nominal_extrinsics" default="false"/>

    <xacro:if value="$(arg use_d435i)">
        <xacro:include filename="$(find realsense2_description)/urdf/_d435i.urdf.xacro" />
        <!-- attach the camera to base_link instead of root -->
        <xacro:sensor_d435i parent="base_link" use_nominal_extrinsics="$(arg use_nominal_extrinsics)">
            <origin xyz="0.22 0 0.03" rpy="0 0 1.57"/>
        </xacro:sensor_d435i>
    </xacro:if>

</robot>